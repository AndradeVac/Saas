# Copie para backend/.env.development (local) ou configure como variáveis de ambiente no servidor.
# ENVIRONMENT (variável do sistema) escolhe o arquivo: development (padrão) -> .env.development,
# production -> .env.production. Variáveis de ambiente reais sempre têm prioridade.

# PostgreSQL (Neon). O prefixo postgresql:// é convertido automaticamente para o driver psycopg.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em producao e obrigatorio (minimo 32 caracteres).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origens do frontend permitidas, separadas por virgula. Aceita curinga de subdominio.
#   local:    http://localhost:5173,http://*.localhost:5173
#   producao: https://mesadigital.app,https://*.mesadigital.app
FRONTEND_URL=http://localhost:5173,http://*.localhost:5173

# Dominio sob o qual cada cliente ganha seu endereco: <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN=localhost
PUBLIC_SCHEME=http
PUBLIC_PORT=:5173
TRIAL_DAYS=14
# WhatsApp de vendas (com DDI) aberto pelos botões "Assinar". Ex.: 5511999990000. Vazio = sem atalho.
SALES_WHATSAPP=

LOG_LEVEL=INFO

# Fotos no Cloudflare R2 (opcional). Sem estes valores, as fotos ficam no banco e saem por /media/<id>.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endereço público do bucket, ex.: https://fotos.seudominio.com
MEDIA_PUBLIC_URL=

# E-mail do sistema (recuperação de senha) via Resend. Vazio = e-mails só aparecem no log (desenvolvimento).
RESEND_API_KEY=
EMAIL_FROM=Mesa Digital <nao-responda@mesadig.com.br>
