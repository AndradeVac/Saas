# Local: "/api" usa o proxy do Vite (vite.config.ts) para http://127.0.0.1:8010.
# Producao (Vercel): URL completa da API, ex.: https://api.mesadigital.app
VITE_API_URL=/api

# Dominio sob o qual cada cliente ganha seu endereco (<slug>.<dominio>).
# Local: localhost  ->  http://<slug>.localhost:5173
VITE_ROOT_DOMAIN=localhost

# Nome da plataforma exibido na pagina inicial e no cadastro.
VITE_APP_NAME=Mesa Digital
